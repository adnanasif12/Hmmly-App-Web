rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['subscriptionstructlab@gmail.com', 'ashibadnan42@gmail.com'];
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // The parent's own data (written by the app and by the website's "delete my data" page).
    match /users/{uid} {
      allow read, write: if owner(uid);
      allow read: if isAdmin();
      match /sessions/{id} {
        allow read, write: if owner(uid);
        allow read: if isAdmin();
      }
      match /gift/{id} {
        allow read, write: if owner(uid);
        allow read: if isAdmin();
      }
    }

    // Admin panel lists every gift / session with one collection-group query.
    match /{path=**}/gift/{id}     { allow read: if isAdmin(); }
    match /{path=**}/sessions/{id} { allow read: if isAdmin(); }

    // Contact form and deletion requests: anyone may add one (validated), only the admin can read or change them.
    match /supportMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'lang', 'status', 'createdAt'])
        && str(request.resource.data.name, 80)
        && str(request.resource.data.email, 120)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(request.resource.data.message, 2000)
        && request.resource.data.lang in ['en', 'bn']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /deletionRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'lang', 'status', 'createdAt'])
        && str(request.resource.data.name, 80)
        && str(request.resource.data.email, 120)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(request.resource.data.message, 2000)
        && request.resource.data.lang in ['en', 'bn']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Book orders (cash on delivery): anyone may place one (validated), only the admin can read or change them.
    match /bookOrders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['orderNo', 'book', 'name', 'phone', 'district', 'address', 'note', 'qty', 'unitPrice', 'delivery', 'total', 'payment', 'lang', 'status', 'createdAt'])
        && str(request.resource.data.orderNo, 20)
        && request.resource.data.book == 'brainy-bee-1'
        && str(request.resource.data.name, 80)
        && str(request.resource.data.phone, 20)
        && request.resource.data.phone.matches('^\\+880[0-9]{8,11}$')
        && str(request.resource.data.district, 60)
        && str(request.resource.data.address, 300)
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 10
        && request.resource.data.unitPrice is int && request.resource.data.delivery is int
        && request.resource.data.total == request.resource.data.unitPrice * request.resource.data.qty + request.resource.data.delivery
        && request.resource.data.payment == 'cod'
        && request.resource.data.lang in ['en', 'bn']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Gift fulfilment status: admin only (parents can never mark their own gift "shipped").
    match /fulfillment/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
